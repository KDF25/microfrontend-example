# ---- Shared / Host ----
APP_NAME=host
APP_VERSION=dev
PORT=3000

# Remote microfrontend locations — resolved at request time by Next.js rewrites.
# In dev these are localhost. In AWS they become internal ALB hostnames or
# service URLs populated by Terraform outputs / SSM parameters.
CATALOG_URL=http://localhost:3001
ACCOUNT_URL=http://localhost:3002

# Shared flags the host exposes to remotes (through headers or SSR props).
FEATURE_PROMO_BANNER=false

# Shared auth (the host is the only app that mints a session)
AUTH_COOKIE_NAME=mf_session
