# ====================================================================
# Monolith env vars — all domains are mixed together on purpose.
# One of the refactor tasks is to split these per microfrontend.
# ====================================================================

APP_NAME=monolith
APP_VERSION=dev
PORT=3000

# Auth (fake)
AUTH_COOKIE_NAME=mf_session
AUTH_MOCK_USER_ID=u-1001

# Catalog
CATALOG_PAGE_SIZE=12

# Account
ACCOUNT_ORDERS_PAGE_SIZE=20

# Checkout
CHECKOUT_PAYMENT_PROVIDER=mock
CHECKOUT_CURRENCY=USD

# Feature flags (flat bag — another intentional smell)
FEATURE_NEW_CART=true
FEATURE_PROMO_BANNER=false
FEATURE_ORDERS_EXPORT=false
