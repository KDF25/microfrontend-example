{
  "name": "mf-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Educational sandbox: decompose a React monolith into microfrontends using Webpack 5 Module Federation, deploy to AWS S3/CloudFront",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter monolith dev",
    "dev:host": "pnpm --filter host dev",
    "dev:catalog": "pnpm --filter catalog dev",
    "dev:account": "pnpm --filter account dev",
    "dev:all": "pnpm -r --parallel --filter \"./apps/{host,catalog,account}\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.3"
  }
}
